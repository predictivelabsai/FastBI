# --- FastBI ---------------------------------------------------------------
FASTBI_ADMIN_EMAIL=admin@fastbi.example
FASTBI_ADMIN_PASSWORD=
FASTBI_SECRET=
FASTBI_PORT=5008
FASTBI_ENV_LABEL=FastBI
FASTBI_DB=

# --- AI (text-to-SQL + chat) ----------------------------------------------
# MODEL_PROVIDER: xai | openai | anthropic | google. Slash-commands need no key.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4.5
XAI_VISION_MODEL=grok-4.5
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fastbi.org/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://fastbi.org
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=

# Optional secondary Neo4j graph engine. The bundled Docker Compose service
# uses a local-only Browser/Bolt binding and seeds examples/retail-ontology.yaml.
FASTBI_GRAPH_ENABLED=0
FASTBI_GRAPH_AUTOSEED=0
FASTBI_GRAPH_ADMIN_EMAILS=admin@fastbi.example
FASTBI_GRAPH_MAX_QUERY_ROWS=200
FASTBI_GRAPH_QUERY_TIMEOUT=5
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
