FROM neo4j:5.26-community

EXPOSE 7474 7687

# Neo4j accepts credentials through NEO4J_AUTH. Derive the password inside the
# container so the health probe uses no extra NEO4J_* setting (strict validation
# treats unknown names as server configuration errors).
HEALTHCHECK --interval=15s --timeout=8s --start-period=60s --retries=10 \
  CMD password="${NEO4J_AUTH#*/}" && cypher-shell -u neo4j -p "$password" "RETURN 1" >/dev/null 2>&1 || exit 1
